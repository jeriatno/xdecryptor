{
    "manifest_version": 3,
    "name": "Decryptor - Hash, Base64 & JWT Decoder",
    "short_name": "Decryptor",
    "version": "1.0.0",
    "description": "Instant decryptor & decoder for MD5, SHA hashes, Base64, Hex, URL encoding, JWT tokens, Caesar cipher, and AES.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "activeTab",
        "scripting",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://www.nitrxgen.net/*",
        "https://*.gromweb.com/*",
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Decryptor",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ],
            "run_at": "document_end"
        }
    ]
}
